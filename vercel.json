{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": { "root": "apps/admin", "framework": "nextjs" },
    "api": { "root": "apps/api", "framework": "fastify" },
    "dashboard": { "root": "apps/dashboard", "framework": "nextjs" },
    "dispatcher": { "root": ".", "runtime": "container" },
    "landing": { "root": "apps/landing", "framework": "nextjs" },
    "worker": { "root": ".", "runtime": "container" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "api" } },
    { "source": "/app/:path*", "destination": { "service": "dashboard" } },
    { "source": "/app", "destination": { "service": "dashboard" } },
    { "source": "/admin-panel/:path*", "destination": { "service": "admin" } },
    { "source": "/:path*", "destination": { "service": "landing" } }
  ]
}
