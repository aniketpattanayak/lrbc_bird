{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": { "root": "apps/admin", "framework": "nextjs" },
    "api": { "root": "apps/api", "framework": "fastify" },
    "dashboard": { "root": "apps/dashboard", "framework": "nextjs" },
    "dispatcher": { "root": ".", "runtime": "container" },
    "landing": { "root": "apps/landing", "framework": "nextjs" },
    "worker": { "root": ".", "runtime": "container" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "api" } },
    { "source": "/login/:path*", "destination": { "service": "dashboard" } },
    { "source": "/login", "destination": { "service": "dashboard" } },
    { "source": "/register/:path*", "destination": { "service": "dashboard" } },
    { "source": "/register", "destination": { "service": "dashboard" } },
    { "source": "/forgot-password/:path*", "destination": { "service": "dashboard" } },
    { "source": "/forgot-password", "destination": { "service": "dashboard" } },
    { "source": "/reset-password/:path*", "destination": { "service": "dashboard" } },
    { "source": "/reset-password", "destination": { "service": "dashboard" } },
    { "source": "/verify-email/:path*", "destination": { "service": "dashboard" } },
    { "source": "/verify-email", "destination": { "service": "dashboard" } },
    { "source": "/overview/:path*", "destination": { "service": "dashboard" } },
    { "source": "/overview", "destination": { "service": "dashboard" } },
    { "source": "/instances/:path*", "destination": { "service": "dashboard" } },
    { "source": "/instances", "destination": { "service": "dashboard" } },
    { "source": "/messages/:path*", "destination": { "service": "dashboard" } },
    { "source": "/messages", "destination": { "service": "dashboard" } },
    { "source": "/templates/:path*", "destination": { "service": "dashboard" } },
    { "source": "/templates", "destination": { "service": "dashboard" } },
    { "source": "/media/:path*", "destination": { "service": "dashboard" } },
    { "source": "/media", "destination": { "service": "dashboard" } },
    { "source": "/webhooks/:path*", "destination": { "service": "dashboard" } },
    { "source": "/webhooks", "destination": { "service": "dashboard" } },
    { "source": "/settings/:path*", "destination": { "service": "dashboard" } },
    { "source": "/settings", "destination": { "service": "dashboard" } },
    { "source": "/billing/:path*", "destination": { "service": "dashboard" } },
    { "source": "/billing", "destination": { "service": "dashboard" } },
    { "source": "/team/:path*", "destination": { "service": "dashboard" } },
    { "source": "/team", "destination": { "service": "dashboard" } },
    { "source": "/wallet/:path*", "destination": { "service": "dashboard" } },
    { "source": "/wallet", "destination": { "service": "dashboard" } },
    { "source": "/api-keys/:path*", "destination": { "service": "dashboard" } },
    { "source": "/api-keys", "destination": { "service": "dashboard" } },
    { "source": "/usage/:path*", "destination": { "service": "dashboard" } },
    { "source": "/usage", "destination": { "service": "dashboard" } },
    { "source": "/onboarding/:path*", "destination": { "service": "dashboard" } },
    { "source": "/onboarding", "destination": { "service": "dashboard" } },
    { "source": "/admin/:path*", "destination": { "service": "admin" } },
    { "source": "/admin", "destination": { "service": "admin" } },
    { "source": "/:path*", "destination": { "service": "landing" } }
  ]
}
