    "@wsaas/config": "*",
    "@wsaas/crypto": "*",
    "@wsaas/database": "*",
    "@wsaas/logger": "*",
    "@wsaas/meta-cloud-api": "*",
    "@wsaas/queue": "*",
    "@wsaas/redis": "*",
    "@wsaas/types": "*",
    "@wsaas/utils": "*",
    "aws-sdk": "^2.1540.0",
    "bullmq": "^5.1.6",
    "dotenv": "^18.0.10",
    "ioredis": "^5.3.2",
    "prom-client": "^15.1.0",
    "qrcode": "^1.5.3",
    "sharp": "^0.33.2",
    "socks-proxy-agent": "^8.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.5",
