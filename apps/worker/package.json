{
  "name": "@wsaas/worker",
  "version": "0.1.0",
  "private": true,
  "main": "dist/worker.js",
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
