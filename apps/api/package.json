{
  "name": "@wsaas/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=verbose src",
    "test:integration": "vitest run --reporter=verbose tests",
    "test:watch": "vitest watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^8.5.0",
    "@fastify/formbody": "^7.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.1.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@fastify/websocket": "^8.3.1",
    "@sentry/node": "^7.99.0",
    "@sentry/profiling-node": "^1.3.5",
    "@types/pg": "^8.23.1",
    "@wsaas/config": "*",
    "@wsaas/crypto": "*",
    "@wsaas/database": "*",
    "@wsaas/logger": "*",
    "@wsaas/meta-cloud-api": "*",
    "@wsaas/queue": "*",
    "@wsaas/redis": "*",
    "@wsaas/types": "*",
    "@wsaas/utils": "*",
    "argon2": "^0.31.2",
    "aws-sdk": "^2.1540.0",
    "dotenv": "^18.0.5",
    "fastify": "^4.26.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "otpauth": "^9.3.4",
    "pg": "^8.23.0",
    "prom-client": "^15.1.0",
    "resend": "^3.2.0",
    "stripe": "^14.16.0",
    "zod": "^3.22.4",
    "razorpay": "^2.9.4"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^6.3.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  }
}